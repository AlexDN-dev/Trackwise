{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/trackwise-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId" ],
    "Properties": {
      "Application": "Trackwise.API"
    }
  },
  "Jwt": {
    "Issuer": "Trackwise",
    "Audience": "TrackwiseClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b-instruct-q4_K_M",
    "KeepAlive": "10m",
    "Temperature": 0.1,
    "MaxOutputTokens": 500,
    "MaxInputChars": 3000,
    "TimeoutSeconds": 120
  },
  "Stripe": {
    "SuccessUrl": "http://localhost:4200/profil/abonnement?success=true",
    "CancelUrl": "http://localhost:4200/profil/abonnement?canceled=true",
    "PortalReturnUrl": "http://localhost:4200/profil/abonnement"
  },
  "AllowedHosts": "*"
}
